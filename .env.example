# name-roulette 環境変数
PORT=3001

# PostgreSQL接続
DB_HOST=172.16.10.11
DB_PORT=5432
DB_NAME=students
DB_USER=name_roulette_ro
DB_PASSWORD=your_password_here

# 推奨: 専用の読み取り専用ユーザーを作成してください
# CREATE USER name_roulette_ro WITH PASSWORD 'xxx';
# GRANT SELECT ON students TO name_roulette_ro;

# Active Directory 認証
AD_LDAP_URL=ldap://172.16.0.1
AD_DOMAIN=yse.ac.jp
AD_BASE_DN=DC=yse,DC=ac,DC=jp
AD_REQUIRED_GROUP=教職員

# セッション（openssl rand -hex 32 などで生成）
SESSION_SECRET=your_session_secret_here
